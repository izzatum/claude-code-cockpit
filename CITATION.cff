    family-names: Izzatullah
    alias: izzatum
version: 0.3.0
license: MIT
repository-code: "https://github.com/izzatum/claude-code-cockpit"
url: "https://github.com/izzatum/claude-code-cockpit#readme"
keywords:
  - claude-code
  - claude-code-plugin
  - status-line
  - context-window
  - session-cost
  - budget-alert
  - mcp
  - rm-rf
  - cloud-sync
